# --- Next.js (브라우저에 노출돼도 되는 값) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # 또는 NEXT_PUBLIC_SUPABASE_ANON_KEY
APP_TIMEZONE=Asia/Seoul

# --- 동기화 스크립트 전용 (절대 NEXT_PUBLIC_ 붙이지 말 것) ---
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
# --- `python sync.py login` (각 사용자 로컬, 비워 두면 터미널에서 물어봄) ---
# APP_EMAIL / APP_PASSWORD: 앱 계정,  GARMIN_EMAIL / GARMIN_PASSWORD: 가민 계정
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=
